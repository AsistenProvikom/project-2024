# ─────────────────────────────────────────────────────────────────────────────
# nginx.conf.template
# LISTEN_PORT diganti oleh start.sh dari $PORT env var Render.com
# ─────────────────────────────────────────────────────────────────────────────

# Map untuk WebSocket upgrade — direkomendasikan nginx docs untuk WS proxy
map $http_upgrade $connection_upgrade {
    default  upgrade;
    ''       close;
}

user root;
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 64;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    access_log    off;
    sendfile      on;

    proxy_read_timeout    86400s;
    proxy_send_timeout    86400s;
    proxy_connect_timeout 10s;

    server {
        listen LISTEN_PORT;
        server_name _;

        # ── 1. Static Portal (HTML/CSS/JS/images/data) ────────────────────────
        location / {
            root  /www;
            index index.html;
            try_files $uri $uri/ /index.html;
        }

        # ── 2. Flask REST API ──────────────────────────────────────────────────
        location /api/ {
            proxy_pass         http://127.0.0.1:5000/api/;
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
            add_header         Access-Control-Allow-Origin  * always;
            add_header         Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
            add_header         Access-Control-Allow-Headers "Content-Type" always;
        }

        # ── 3. noVNC static files (served directly from filesystem) ───────────
        #    LEBIH RELIABLE daripada proxying ke websockify
        location /novnc/ {
            alias /usr/share/novnc/;
            try_files $uri $uri/ =404;
        }

        # ── 4. WebSocket proxy: noVNC ↔ websockify ↔ x11vnc ──────────────────
        #    Semua path di-forward ke websockify (termasuk /websockify)
        location /websockify {
            proxy_pass         http://127.0.0.1:6080;
            proxy_http_version 1.1;
            proxy_set_header   Upgrade    $http_upgrade;
            proxy_set_header   Connection $connection_upgrade;
            proxy_set_header   Host       $host;
            proxy_read_timeout 86400s;
        }
    }
}
