# ─────────────────────────────────────────────────────────────────────────────
# nginx.conf.template — SIMPLIFIED
# Semua noVNC traffic (static + WebSocket) lewat satu proxy ke websockify
# ─────────────────────────────────────────────────────────────────────────────

user root;
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 64;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    access_log    off;
    sendfile      on;

    map $http_upgrade $connection_upgrade {
        default  upgrade;
        ''       close;
    }

    server {
        listen LISTEN_PORT;
        server_name _;

        # ── 1. Static Portal ──────────────────────────────────────────────────
        location / {
            root  /www;
            index index.html;
            try_files $uri $uri/ /index.html;
        }

        # ── 2. Flask API ──────────────────────────────────────────────────────
        location /api/ {
            proxy_pass http://127.0.0.1:5000/api/;
            proxy_set_header Host $host;
        }

        # ── 3. noVNC: static files + WebSocket — ALL go to websockify ─────────
        #    websockify runs with --web=/usr/share/novnc on port 6080
        #    /novnc/vnc.html  → proxied to → http://localhost:6080/vnc.html
        #    /novnc/websockify → proxied to → http://localhost:6080/websockify (WS)
        location /novnc/ {
            proxy_pass         http://127.0.0.1:6080/;
            proxy_http_version 1.1;
            proxy_set_header   Upgrade    $http_upgrade;
            proxy_set_header   Connection $connection_upgrade;
            proxy_set_header   Host       $host;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }
    }
}
